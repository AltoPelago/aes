{
  "meta": {
    "suite_id": "transaction-body-and-integrity",
    "lane": "aes-transaction",
    "transaction_contract": "aes.transaction.v0",
    "envelope_contract": "aes.transaction.envelope.v0",
    "integrity_contract": "aes.transaction.integrity.v0",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "specifications/aes.transactions.md#3-transaction-body",
      "specifications/aes.transactions.md#6-initial-scalar-value-replacement-application",
      "specifications/aes.transactions.md#7-transaction-integrity"
    ]
  },
  "id": "transaction-body-and-integrity",
  "title": "AES v0 Transaction Body, Envelope, and Integrity",
  "tests": [
    {
      "id": "aes-transaction-001-scalar-body-digest",
      "operation": "digest",
      "input": { "body_ref": "scalar" },
      "expected": {
        "digest": "6a9651091dd10bacecf54c69c8dafe151dabd74ddbc809174cc9c250c35bbfa3",
        "logical_hex": ""
      }
    },
    {
      "id": "aes-transaction-002-target-binding",
      "operation": "digest",
      "input": { "body_ref": "scalar", "patch": { "target.id": "database-2" } },
      "expected": { "digest": "080d880a980217b21f9cef09c77fd559f556af35a58e25add98dc1ecbf559065" }
    },
    {
      "id": "aes-transaction-003-registered-extension-binding",
      "operation": "digest",
      "input": { "body_ref": "scalar", "patch": { "x.example.note": "bound" }, "registered_fields": ["x.example.note"] },
      "expected": { "digest": "5037f5cf843a1c42b5f7a801c83b73bdadf21037cfa345f9e92af8100fce6cac" }
    },
    {
      "id": "aes-transaction-004-event-count-mismatch",
      "operation": "validate-body",
      "input": { "body_ref": "scalar", "patch": { "assertions.eventCount": "2" } },
      "expected": { "valid": false, "diagnostic_codes": ["AES_TRANSACTION_ASSERTION_FAILED", "AES_TRANSACTION_APPLICATION_INVALID"] }
    },
    {
      "id": "aes-transaction-005-identity-collision",
      "operation": "validate-body",
      "input": { "body_ref": "scalar", "patch": { "attempt": "tx-1" } },
      "expected": { "valid": false, "diagnostic_codes": ["AES_TRANSACTION_BODY_INVALID"] }
    },
    {
      "id": "aes-transaction-006-scalar-widening-rejected",
      "operation": "validate-body",
      "input": { "body_ref": "scalar", "patch": { "records.0.datatype": "string", "records.0.generics": [], "records.0.clarifiers": [] } },
      "expected": { "valid": false, "diagnostic_codes": ["AES_TRANSACTION_APPLICATION_INVALID"] }
    },
    {
      "id": "aes-transaction-007-unregistered-extension",
      "operation": "validate-body",
      "input": { "body_ref": "scalar", "patch": { "x.example.note": "bound" } },
      "expected": { "valid": false, "diagnostic_codes": ["AES_TRANSACTION_EXTENSION_UNREGISTERED"] }
    },
    {
      "id": "aes-transaction-008-unsigned-inspection",
      "operation": "validate-envelope",
      "input": { "body_ref": "scalar", "evidence": null },
      "expected": { "valid": true, "evidence_verified": false, "diagnostic_codes": [] }
    },
    {
      "id": "aes-transaction-009-required-evidence",
      "operation": "validate-envelope",
      "input": { "body_ref": "scalar", "evidence": null, "require_evidence": true },
      "expected": { "valid": false, "evidence_verified": false, "diagnostic_codes": ["AES_TRANSACTION_INTEGRITY_INVALID"] }
    },
    {
      "id": "aes-transaction-010-digest-evidence",
      "operation": "validate-envelope",
      "input": { "body_ref": "scalar", "evidence_ref": "scalar-digest", "require_evidence": true },
      "expected": { "valid": true, "evidence_verified": true, "diagnostic_codes": [] }
    },
    {
      "id": "aes-transaction-011-support-gate",
      "operation": "inspect-envelope",
      "input": { "body_ref": "scalar", "evidence_ref": "scalar-digest", "require_evidence": true },
      "expected": { "valid": true, "supported": false, "evidence_verified": true, "ready_for_authorization": false, "actionable": false, "diagnostic_codes": ["AES_TRANSACTION_UNSUPPORTED_CONTRACT"] }
    },
    {
      "id": "aes-transaction-012-registered-support",
      "operation": "inspect-envelope",
      "input": { "body_ref": "scalar", "evidence_ref": "scalar-digest", "require_evidence": true, "support_ref": "scalar" },
      "expected": { "valid": true, "supported": true, "evidence_verified": true, "ready_for_authorization": true, "actionable": false, "diagnostic_codes": [] }
    },
    {
      "id": "aes-transaction-013-tampered-evidence",
      "operation": "validate-envelope",
      "input": { "body_ref": "scalar", "evidence_ref": "tampered" },
      "expected": { "valid": false, "evidence_verified": false, "diagnostic_codes": ["AES_TRANSACTION_INTEGRITY_MISMATCH"] }
    },
    {
      "id": "aes-transaction-014-signature-context",
      "operation": "signature-input",
      "input": { "digest": "6a9651091dd10bacecf54c69c8dafe151dabd74ddbc809174cc9c250c35bbfa3", "alg": "ed25519", "kid": "alice" },
      "expected": {
        "logical_hex": ""
      }
    }
  ]
}
