  "id": "next-telex-type-only-generics",
  "title": "Telex Type-only Generics",
  "tests": [
    {
      "id": "telex-type-generics-001-reject",
      "description": "Telex does not extend the shared generic grammar",
      "operation": "parse",
      "input": {
        "telex": "telex.aes=1\n\npath=$.a\nkind=NumberLiteral\ndatatype=custom<1>\nvalue=0\n"
      },
      "expected": {
        "ok": false,
        "error": {
          "code": "TELEX_INVALID_DATATYPE",
          "line": 5
        }
      },
      "tags": [
        "experimental",
        "generics",
        "reject"
      ]
    },
    {
      "id": "telex-type-generics-002-reject",
