    {
      "id": "telex-type-generics-012-clarifiers",
      "description": "Numeric clarifiers remain exact in recursive type descriptors",
      "operation": "parse",
      "input": {
        "telex": "telex.aes=1\n\npath=$.a\nkind=NumberLiteral\ndatatype=custom<custom[9007199254740993]>[1.0]\nvalue=0\n"
      },
      "expected": {
        "ok": true,
        "version": "1",
        "profile": "aes.complete.v1",
        "profile_explicit": false,
        "projection": null,
        "projection_explicit": false,
        "canonical": true,
        "records": [
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "datatype": "custom",
            "generics": [
              {
                "datatype": "custom",
                "generics": [],
                "clarifiers": [
                  {
                    "kind": "NumberLiteral",
                    "value": "9007199254740993"
                  }
                ]
              }
            ],
            "clarifiers": [
              {
                "kind": "NumberLiteral",
                "value": "1.0"
              }
            ],
            "value": "0"
          }
        ]
      },
      "tags": [
        "experimental",
        "generics",
        "clarifiers",
        "accept"
      ]
    },
    {
      "id": "telex-type-generics-components-3",
      "description": "Type-only generic descriptors retain datatype-component accounting",
      "operation": "canonicalize",
      "input": {
        "limits": {
          "max_datatype_components": 3
        },
        "telex": "telex.aes=1\n\npath=$.a\nkind=TupleLiteral\ndatatype=tuple<int, string>\n"
      },
      "expected": {
        "ok": true,
        "telex": "telex.aes=1\n\npath=$.a\nkind=TupleLiteral\ndatatype=tuple<int, string>\n"
      },
      "tags": [
        "experimental",
        "generics",
        "limits",
        "accept"
      ]
    },
