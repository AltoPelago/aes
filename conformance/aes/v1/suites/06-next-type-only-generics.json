  "id": "next-aes-events-type-only-generics",
  "title": "Logical AES Type-only Generics",
  "tests": [
    {
      "id": "aes-events-type-generics-001-reject",
      "description": "Logical AES generic arrays contain only type descriptors",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "datatype": "custom",
            "generics": [
              {
                "kind": "NumberLiteral",
                "value": "1"
              }
            ],
            "clarifiers": [],
            "value": "0"
          }
        ]
      },
      "expected": {
        "valid": false,
        "profile": "aes.complete.v1",
        "diagnostic_codes": [
          "AES_INVALID_DATATYPE"
        ]
      },
      "tags": [
        "experimental",
        "generics",
        "reject"
      ]
    },
