      "expected": {
        "valid": false,
        "profile": "aes.partial.v1",
        "diagnostic_codes": [
          "AES_INVALID_PATH"
        ]
      },
      "tags": [
        "validation",
        "path",
        "quoted-member",
        "failure"
      ]
    },
    {
      "id": "aes-events-021-explicit-header-plane",
      "description": "The AEON document projection carries a complete flat header plane before a complete body",
      "operation": "validate",
      "input": {
        "records": [
          {
            "header": "$.[\"aeon:conventions\"]",
            "kind": "ListNode"
          },
          {
            "header": "$.[\"aeon:conventions\"][0]",
            "kind": "StringLiteral",
            "value": "aeon.gp.security.v1"
          },
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "value": "1"
          }
        ],
        "projection": "aeon.document.v1"
      },
      "expected": {
        "valid": true,
        "profile": "aes.complete.v1",
        "diagnostic_codes": []
      },
      "tags": [
        "validation",
        "projection",
        "header",
        "complete"
      ]
    },
    {
      "id": "aes-events-022-header-requires-projection",
      "description": "Header records are not part of the default body projection",
      "operation": "validate",
      "input": {
        "records": [
          {
            "header": "$.[\"aeon:mode\"]",
            "kind": "StringLiteral",
            "value": "strict"
          }
        ]
      },
      "expected": {
        "valid": false,
        "profile": "aes.complete.v1",
        "diagnostic_codes": [
          "AES_HEADER_REQUIRES_PROJECTION"
