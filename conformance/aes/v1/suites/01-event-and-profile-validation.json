        "profile": "aes.partial.v1"
      },
      "expected": {
        "valid": false,
        "profile": "aes.partial.v1",
        "diagnostic_codes": [
          "AES_INVALID_REFERENCE"
        ]
      },
      "tags": [
        "validation",
        "event-shape",
        "reference",
        "failure"
      ]
    },
    {
      "id": "aes-events-014-span-shape",
      "description": "A source span is an ordered pair of canonical byte offsets",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "value": "1",
            "origin": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "span": "4:2"
          }
        ],
        "profile": "aes.partial.v1"
      },
      "expected": {
        "valid": false,
        "profile": "aes.partial.v1",
        "diagnostic_codes": [
          "AES_INVALID_SPAN"
        ]
      },
      "tags": [
        "validation",
        "event-shape",
        "span",
        "failure"
      ]
    },
    {
      "id": "aes-events-015-unregistered-extension",
      "description": "An extension field is rejected unless the selected validation context registers it exactly",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "value": "1",
            "x.example.claim": "yes"
          }
        ],
        "profile": "aes.partial.v1"
      },
      "expected": {
        "valid": false,
        "profile": "aes.partial.v1",
        "diagnostic_codes": [
          "AES_UNKNOWN_FIELD"
        ]
      },
      "tags": [
        "validation",
        "extension",
        "failure"
      ]
    },
    {
      "id": "aes-events-016-registered-extension",
      "description": "Exact extension registration enables only the named field",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "value": "1",
            "x.example.claim": "yes"
          }
        ],
        "profile": "aes.partial.v1",
        "registered_fields": [
          "x.example.claim"
        ]
      },
      "expected": {
        "valid": true,
        "profile": "aes.partial.v1",
        "diagnostic_codes": []
      },
      "tags": [
        "validation",
        "extension"
      ]
    },
    {
      "id": "aes-events-017-unsupported-profile",
      "description": "Syntax readers preserve unknown profiles but semantic validation fails closed",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "value": "1"
          }
        ],
        "profile": "x.example.future.v1"
      },
      "expected": {
        "valid": false,
        "profile": "x.example.future.v1",
        "diagnostic_codes": [
          "AES_UNSUPPORTED_PROFILE"
        ]
      },
      "tags": [
        "validation",
        "profile",
        "failure"
      ]
    },
    {
      "id": "aes-events-018-unknown-kind",
