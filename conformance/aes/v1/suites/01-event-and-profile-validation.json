    },
    {
      "id": "aes-events-019-quoted-attribute-path",
      "description": "Quoted members and attribute owners participate in the same complete path structure",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "ObjectNode"
          },
          {
            "path": "$.a.@.[\"x.y\"]",
            "kind": "ObjectNode"
          },
          {
            "path": "$.a.@.[\"x.y\"].[\"deep key\"]",
            "kind": "StringLiteral",
            "value": "yes"
          }
        ]
      },
      "expected": {
        "valid": true,
        "profile": "aes.complete.v1",
        "diagnostic_codes": []
      },
      "tags": [
        "validation",
        "complete",
        "attributes",
        "quoted-member"
      ]
    },
    {
      "id": "aes-events-020-unnecessarily-quoted-member",
      "description": "A member that is legal in bare form must use that canonical form",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.[\"a\"]",
            "kind": "NumberLiteral",
            "value": "1"
          }
