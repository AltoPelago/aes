{
  "meta": {
    "suite_id": "event-and-profile-validation",
    "lane": "aes-events",
    "event_contract": "aes.events.v1",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "specifications/aes.events.md#3-record-shape",
      "specifications/aes.events.md#4-datatypes-and-values",
      "specifications/aes.events.md#5-flat-structure-and-identity",
      "specifications/aes.events.md#7-provenance-and-spans",
      "specifications/aes.events.md#9-completeness-profiles",
      "specifications/aes.events.md#10-optional-aeon-document-projection",
      "specifications/aes.events.md#12-validation-and-diagnostics"
    ]
  },
  "id": "event-and-profile-validation",
  "title": "Portable AES v1 Event and Profile Validation",
  "tests": [
    {
      "id": "aes-events-001-complete-default",
      "description": "The implicit complete profile accepts flat objects, attributes, lists, nodes, and node content",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "ObjectNode",
            "identity": "root-a"
          },
          {
            "path": "$.a.@.source",
            "kind": "StringLiteral",
            "value": "fixture"
          },
          {
            "path": "$.a.items",
            "kind": "ListNode"
          },
          {
            "path": "$.a.items[0]",
            "kind": "NodeLiteral"
          },
          {
            "path": "$.a.items[0][0]",
            "kind": "NodeHead",
            "value": "tag"
          },
          {
            "path": "$.a.items[0][0][0]",
            "kind": "BooleanLiteral",
            "value": "true",
            "origin": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "span": "8:12"
          }
        ]
      },
      "expected": {
        "valid": true,
        "profile": "aes.complete.v1",
        "diagnostic_codes": []
      },
      "tags": [
        "validation",
        "complete",
        "attributes",
        "node"
      ]
    },
    {
      "id": "aes-events-002-default-missing-parent",
      "description": "The default profile rejects a descendant whose parent event is absent",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a.b",
            "kind": "NumberLiteral",
            "value": "1"
          }
        ]
      },
      "expected": {
        "valid": false,
        "profile": "aes.complete.v1",
        "diagnostic_codes": [
          "AES_MISSING_PARENT"
        ]
      },
      "tags": [
        "validation",
        "complete",
        "ancestry",
        "failure"
      ]
    },
    {
      "id": "aes-events-003-partial-missing-parent",
      "description": "The explicit partial profile permits a valid event without its parent context",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a.b",
            "kind": "NumberLiteral",
            "value": "1"
          }
        ],
        "profile": "aes.partial.v1"
      },
      "expected": {
        "valid": true,
        "profile": "aes.partial.v1",
        "diagnostic_codes": []
      },
      "tags": [
        "validation",
        "partial",
        "ancestry"
      ]
    },
    {
      "id": "aes-events-004-partial-retains-event-validity",
      "description": "Partial changes stream constraints but does not permit an invalid event value",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "BooleanLiteral",
            "value": "True"
          }
        ],
        "profile": "aes.partial.v1"
      },
      "expected": {
        "valid": false,
        "profile": "aes.partial.v1",
        "diagnostic_codes": [
          "AES_INVALID_VALUE"
        ]
      },
      "tags": [
        "validation",
        "partial",
        "event-shape",
        "failure"
      ]
    },
    {
      "id": "aes-events-005-default-duplicates",
      "description": "Complete streams require unique paths and structural identities",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "identity": "same",
            "value": "1"
          },
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "identity": "same",
            "value": "2"
          }
        ]
      },
      "expected": {
        "valid": false,
        "profile": "aes.complete.v1",
        "diagnostic_codes": [
          "AES_DUPLICATE_PATH",
          "AES_DUPLICATE_IDENTITY"
        ]
      },
      "tags": [
        "validation",
        "complete",
        "uniqueness",
        "failure"
      ]
    },
    {
      "id": "aes-events-006-partial-duplicates",
      "description": "Partial history may repeat paths and structural identities across events",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "identity": "same",
            "value": "1"
          },
          {
            "path": "$.a",
            "kind": "NumberLiteral",
            "identity": "same",
            "value": "2"
          }
        ],
        "profile": "aes.partial.v1"
      },
      "expected": {
        "valid": true,
        "profile": "aes.partial.v1",
        "diagnostic_codes": []
      },
      "tags": [
        "validation",
        "partial",
        "history",
        "duplicates"
      ]
    },
    {
      "id": "aes-events-007-incompatible-member-parent",
      "description": "A named structural child requires an object parent",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.scalar",
            "kind": "NumberLiteral",
            "value": "1"
          },
          {
            "path": "$.scalar.child",
            "kind": "StringLiteral",
            "value": "no"
          }
        ]
      },
      "expected": {
        "valid": false,
        "profile": "aes.complete.v1",
        "diagnostic_codes": [
          "AES_INCOMPATIBLE_PARENT"
        ]
      },
      "tags": [
        "validation",
        "complete",
        "container",
        "failure"
      ]
    },
    {
      "id": "aes-events-008-node-head-placement",
      "description": "A node-head cannot be used as an ordinary list item",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.items",
            "kind": "ListNode"
          },
          {
            "path": "$.items[0]",
            "kind": "NodeHead",
            "value": "tag"
          }
        ]
      },
      "expected": {
        "valid": false,
        "profile": "aes.complete.v1",
        "diagnostic_codes": [
          "AES_INVALID_NODE_HEAD"
        ]
      },
      "tags": [
        "validation",
        "complete",
        "node-head",
        "failure"
      ]
    },
    {
      "id": "aes-events-009-node-requires-head-child",
      "description": "Every direct indexed child of a node is a node-head event",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.item",
            "kind": "NodeLiteral"
          },
          {
            "path": "$.item[0]",
            "kind": "StringLiteral",
            "value": "not-a-head"
          }
        ]
      },
      "expected": {
        "valid": false,
        "profile": "aes.complete.v1",
        "diagnostic_codes": [
          "AES_INCOMPATIBLE_PARENT"
        ]
      },
      "tags": [
        "validation",
        "complete",
        "node",
        "failure"
      ]
    },
    {
      "id": "aes-events-010-root-is-not-owner",
      "description": "The unrepresented document root cannot own indexed or attribute events",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$[0]",
            "kind": "NumberLiteral",
            "value": "1"
          },
          {
            "path": "$.@.meta",
            "kind": "StringLiteral",
            "value": "root"
          }
        ]
      },
      "expected": {
        "valid": false,
        "profile": "aes.complete.v1",
        "diagnostic_codes": [
          "AES_MISSING_PARENT",
          "AES_MISSING_PARENT"
        ]
      },
      "tags": [
        "validation",
        "complete",
        "root",
        "failure"
      ]
    },
    {
      "id": "aes-events-011-value-presence",
      "description": "Containers omit value while non-container kinds require it",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "ObjectNode",
            "value": "nested"
          },
          {
            "path": "$.b",
            "kind": "NumberLiteral"
          }
        ],
        "profile": "aes.partial.v1"
      },
      "expected": {
        "valid": false,
        "profile": "aes.partial.v1",
        "diagnostic_codes": [
          "AES_UNEXPECTED_VALUE",
          "AES_MISSING_VALUE"
        ]
      },
      "tags": [
        "validation",
        "event-shape",
        "value",
        "failure"
      ]
    },
    {
      "id": "aes-events-012-locally-defined-values",
      "description": "Kinds with locally specified vocabularies use their exact canonical payloads",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.hex",
            "kind": "HexLiteral",
            "value": "CAFE"
          },
          {
            "path": "$.toggle",
            "kind": "ToggleLiteral",
            "value": "enabled"
          },
          {
            "path": "$.nan",
            "kind": "NaNLiteral",
            "value": "nan"
          }
        ],
        "profile": "aes.partial.v1"
      },
      "expected": {
        "valid": false,
        "profile": "aes.partial.v1",
        "diagnostic_codes": [
          "AES_INVALID_VALUE",
          "AES_INVALID_VALUE",
          "AES_INVALID_VALUE"
        ]
      },
      "tags": [
        "validation",
        "event-shape",
        "canonical-value",
        "failure"
      ]
    },
    {
      "id": "aes-events-013-reference-target-shape",
      "description": "Clone and pointer payloads contain canonical absolute target paths",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.copy",
