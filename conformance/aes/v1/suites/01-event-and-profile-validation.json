    {
      "id": "aes-events-029-node-path-and-reference-domain",
      "description": "Expanded node heads, independently identified occurrences, and reference payloads share the portable AES event-path domain",
      "operation": "validate",
      "input": {
        "records": [
          {
            "path": "$.a",
            "kind": "NodeLiteral",
            "identity": "binding-a"
          },
          {
            "path": "$.a.@.x",
            "kind": "StringLiteral",
            "identity": "binding-attribute",
            "value": "outer"
          },
          {
            "path": "$.a[0]",
            "kind": "NodeHead",
            "identity": "head-a",
            "value": "tag"
          },
          {
            "path": "$.a[0].@.x",
            "kind": "StringLiteral",
            "identity": "head-attribute",
            "value": "head"
          },
          {
            "path": "$.a[0][0]",
            "kind": "NodeLiteral",
            "identity": "child-a"
          },
          {
            "path": "$.a[0][0][0]",
            "kind": "NodeHead",
            "identity": "child-head",
            "value": "inner"
          },
          {
            "path": "$.a[0][0][0][0]",
            "kind": "StringLiteral",
            "identity": "leaf",
            "value": "value"
          },
          {
            "path": "$.clone",
            "kind": "CloneReference",
            "value": "$.a[0][0]"
          },
          {
            "path": "$.pointer",
            "kind": "PointerReference",
            "value": "$.a[0][0][0][0]"
          }
        ]
      },
      "expected": {
        "valid": true,
        "profile": "aes.complete.v1",
        "diagnostic_codes": []
      },
      "tags": [
        "validation",
        "complete",
        "node",
        "node-head",
        "identity",
        "reference",
        "path"
      ]
    },
