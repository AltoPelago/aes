  "id": "next-film-type-only-generics",
  "title": "Film Type-only Generics",
  "tests": [
    {
      "id": "film-type-generics-001-legacy-number-tag",
      "description": "Historical numeric generic framing cannot produce an accepted logical AES record",
      "operation": "decode",
      "input": {
        "film_hex": "4f5f5fff01010e6165732e7061727469616c2e76316b1e020a242e6974656d735b305d19046c69737402000603696e7400000201330201012e020231300962696e64696e672d300234320123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0a140e782e6578616d706c652e6e6f746505636166c3a9",
        "registered_fields": [
          "x.example.note"
        ],
        "limits": {
          "max_generic_arguments": 2,
          "max_clarifier_values": 2
        }
      },
      "expected": {
        "ok": false,
        "error": {
          "code": "FILM_AES_INVALID",
          "stage": "aes",
          "diagnostic_codes": [
            "AES_INVALID_DATATYPE"
          ]
        }
      },
      "tags": [
        "experimental",
        "generics",
        "logical-aes",
        "reject"
      ]
    },
    {
      "id": "film-type-generics-002-nested-clarifiers",
      "description": "Generic tag 00 and numeric clarifier tag 02 retain their existing values",
      "operation": "decode",
      "input": {
        "film_hex": "4f5f5fff010034020203242e612b06637573746f6d01001b06637573746f6d0001021039303037313939323534373430393933010203312e300130"
      },
      "expected": {
        "ok": true,
        "canonical_hex": "4f5f5fff010034020203242e612b06637573746f6d01001b06637573746f6d0001021039303037313939323534373430393933010203312e300130",
        "stream": {
          "profile": "aes.complete.v1",
          "profile_explicit": false,
          "projection": null,
          "projection_explicit": false,
          "records": [
            {
              "path": "$.a",
              "kind": "NumberLiteral",
              "datatype": "custom",
              "generics": [
                {
                  "datatype": "custom",
                  "generics": [],
                  "clarifiers": [
                    {
                      "kind": "NumberLiteral",
                      "value": "9007199254740993"
                    }
                  ]
                }
              ],
              "clarifiers": [
                {
                  "kind": "NumberLiteral",
                  "value": "1.0"
                }
              ],
              "value": "0"
            }
          ]
        }
      },
      "tags": [
        "experimental",
        "generics",
        "clarifiers",
        "accept"
      ]
    },
    {
      "id": "film-type-generics-003-encode-clarifiers",
      "description": "A type-only descriptor encodes without changing numeric clarifier tags",
      "operation": "encode",
      "input": {
        "stream": {
          "profile": "aes.complete.v1",
          "profile_explicit": false,
          "projection": null,
          "projection_explicit": false,
          "records": [
            {
              "path": "$.a",
              "kind": "NumberLiteral",
              "datatype": "custom",
              "generics": [
                {
                  "datatype": "custom",
                  "generics": [],
                  "clarifiers": [
                    {
                      "kind": "NumberLiteral",
                      "value": "9007199254740993"
                    }
                  ]
                }
              ],
              "clarifiers": [
                {
                  "kind": "NumberLiteral",
                  "value": "1.0"
                }
              ],
              "value": "0"
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "film_hex": "4f5f5fff010034020203242e612b06637573746f6d01001b06637573746f6d0001021039303037313939323534373430393933010203312e300130"
      },
      "tags": [
        "experimental",
        "generics",
        "clarifiers",
        "accept"
      ]
    },
    {
      "id": "film-type-generics-004-transcode-clarifiers",
      "description": "Telex and Film retain exactly the same nested numeric clarifier strings",
      "operation": "transcode",
      "input": {
        "telex": "telex.aes=1\n\npath=$.a\nkind=NumberLiteral\ndatatype=custom<custom[9007199254740993]>[1.0]\nvalue=0\n"
      },
      "expected": {
        "ok": true,
        "film_hex": "4f5f5fff010034020203242e612b06637573746f6d01001b06637573746f6d0001021039303037313939323534373430393933010203312e300130",
        "telex": "telex.aes=1\n\npath=$.a\nkind=NumberLiteral\ndatatype=custom<custom[9007199254740993]>[1.0]\nvalue=0\n"
      },
      "tags": [
        "experimental",
        "generics",
        "clarifiers",
        "transcode"
      ]
    },
